#!/usr/bin/env bash
# Refuse commits that add images still carrying metadata (GPS, camera, dates, ...).
# Fix with: npm run clean-images
set -euo pipefail

images=$(git diff --cached --name-only --diff-filter=ACMR -z |
  tr '\0' '\n' | grep -iE '\.(jpe?g|png|webp|gif|tiff?|heic)$' || true)
[ -z "$images" ] && exit 0

if ! command -v exiftool >/dev/null; then
  echo "pre-commit: exiftool is required to check images for metadata." >&2
  echo "Install it with: sudo apt install libimage-exiftool-perl" >&2
  exit 1
fi

# Tags that are harmless image-structure info, not personal metadata.
allowed='^\[(EXIF)\] (Orientation|YCbCrPositioning|XResolution|YResolution|ResolutionUnit|ExifByteOrder):|^\[PNG\] (ImageWidth|ImageHeight|BitDepth|ColorType|Compression|Filter|Interlace|BackgroundColor|Gamma|SRGBRendering|PixelsPerUnitX|PixelsPerUnitY|PixelUnits|Palette|Transparency|WhitePoint(X|Y)?|(Red|Green|Blue)(X|Y)):'

failed=0
while IFS= read -r f; do
  # Check the staged version, not the working tree copy.
  found=$(git show ":$f" | exiftool -q -q -m -s -s -G0 \
    -EXIF:all -XMP:all -IPTC:all -Photoshop:all -MakerNotes:all -PNG:all -Comment - |
    grep -vE "$allowed" || true)
  if [ -n "$found" ]; then
    echo "pre-commit: $f still has metadata:" >&2
    echo "$found" | head -n 8 | sed 's/^/    /' >&2
    [ "$(echo "$found" | wc -l)" -gt 8 ] && echo "    ..." >&2
    failed=1
  fi
done <<< "$images"

if [ $failed -ne 0 ]; then
  echo >&2
  echo "Strip it with: npm run clean-images -- <files>   (then git add them again)" >&2
  exit 1
fi
