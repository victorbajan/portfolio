---
layout: base.njk
---
{%- macro projectCard(project, index, linkLabel = "View project") -%}
<article class="card">
  <p class="card-index">{{ index if index > 9 else "0" ~ index }} / {{ project.data.context }}</p>
  <h3 class="card-title"><a class="card-cover" href="{{ project.url }}">{{ project.data.title }}</a></h3>
  {% if project.data.summary %}<p class="card-body">{{ project.data.summary }}</p>{% endif %}
  {% if project.data.stack.length %}
  <ul class="tags">
    {% for item in project.data.stack %}<li>{{ item }}</li>{% endfor %}
  </ul>
  {% endif %}
  <span class="link-arrow card-link" aria-hidden="true">{{ linkLabel }}</span>
</article>
{%- endmacro -%}

{%- set cv = collections.cv | first -%}

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow">{{ eyebrow }}</p>
      <h1 class="hero-title">{{ title }}</h1>
      <div class="hero-lead prose">{{ content | safe }}</div>
      <div class="actions">
        <a class="btn btn-primary" href="#projects">See projects</a>
        <a class="btn btn-secondary" href="#cv">Read my CV</a>
      </div>
    </div>
    {% if photo %}<img class="hero-photo" src="{{ photo }}" alt="Portrait of Victor Bajan" width="886" height="886">{% endif %}
  </div>
</section>

<section id="cv" class="section">
  <div class="container">
    <p class="eyebrow">01 / CV</p>
    <h2 class="section-title">Curriculum vitae</h2>
    {% if cv.data.summary %}<p class="reading">{{ cv.data.summary }}</p>{% endif %}
    <div class="cv prose">{{ cv.content | safe }}</div>
    {% if cv.data.file %}
    <div class="actions">
      <a class="btn btn-secondary" href="{{ cv.data.file }}">Download CV (PDF)</a>
    </div>
    {% endif %}
  </div>
</section>

<section id="events" class="section band band--dark">
  <div class="container">
    <p class="eyebrow">02 / Events</p>
    <h2 class="section-title">Events</h2>
    <p class="reading">{{ sections.events }}</p>
    <div class="card-grid">
      {% for project in collections.events | sort(false, false, "data.order") %}{{ projectCard(project, loop.index, "View event") }}{% endfor %}
    </div>
  </div>
</section>

<section id="projects" class="section band band--wash">
  <div class="container">
    <p class="eyebrow">03 / Projects</p>
    <h2 class="section-title">Projects</h2>
    <p class="reading">{{ sections.projects }}</p>
    <div class="card-grid">
      {% for project in collections.projects | sort(false, false, "data.order") %}{{ projectCard(project, loop.index) }}{% endfor %}
    </div>
  </div>
</section>
